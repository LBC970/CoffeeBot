{
  "display_information": {
    "name": "Coffee Pairing Bot",
    "description": "Automatically pairs colleagues for coffee chats",
    "background_color": "#6F4E37"
  },
  "features": {
    "bot_user": {
      "display_name": "Coffee Pairing Bot",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/coffee-admin",
        "description": "Admin commands for the coffee pairing system",
        "usage_hint": "help | pair-now | post-signup",
        "url": "https://your-api-gateway-url/slack/commands",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "channels:history",
        "channels:read",
        "chat:write",
        "commands",
        "reactions:read",
        "users:read",
        "users:read.email",
        "app_mentions:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://your-api-gateway-url/slack/events",
      "bot_events": [
        "reaction_added",
        "app_mention"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://your-api-gateway-url/slack/interactions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false
  }
}
